[alias]
	cleanup = !git branch --merged|grep -iEv \"(^\\*|master|develop)\"|xargs git branch -d
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
